# GitHub Actions CI — EXAMPLE (not active).
#
# The template ships no live CI by design, to stay provider-agnostic. To enable
# it on GitHub: rename this file to `ci.yml`. If you scaffolded with
# `make new-app`, update PROJECT/SCHEME below — and the Package.resolved path in
# the SPM cache key — to your renamed project (the rename script does not touch
# CI YAML).
#
# Two jobs run in parallel:
#   • lint — SwiftFormat + SwiftLint via `make verify-github` (no Xcode needed,
#     so it returns in seconds and emits inline PR annotations).
#   • test — builds + runs the unit tests, uploads the .xcresult bundle.
# See docs/TOOLING.md → "Adding CI".

name: CI

on:
  push:
    branches: [main]
  pull_request:

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

# Least privilege: this workflow only reads the repo and uploads artifacts.
permissions:
  contents: read

jobs:
  # Job 1: SwiftFormat + SwiftLint — no Xcode/simulator, so it fails fast.
  lint:
    runs-on: macos-15
    steps:
      - uses: actions/checkout@v5

      # Cache the compiled, pinned SwiftLint/SwiftFormat binaries, keyed on the Mintfile.
      - name: Cache Mint
        uses: actions/cache@v5
        with:
          path: ~/.mint
          key: mint-${{ runner.os }}-${{ hashFiles('Mintfile') }}

      - name: Install pinned tools (Mint)
        run: |
          brew install mint
          mint bootstrap

      - name: Lint + format check
        run: make verify-github

  # Job 2: build + run unit tests.
  test:
    runs-on: macos-15
    timeout-minutes: 30
    env:
      PROJECT: iOSAppTemplate.xcodeproj
      SCHEME: iOSAppTemplate-Dev
    steps:
      - uses: actions/checkout@v5

      # `latest-stable` floats to the newest released Xcode on the runner image.
      # Pin a version (e.g. `xcode-version: '16.2'`) if you need byte-reproducible
      # builds at the cost of manual bumps.
      - name: Select Xcode
        uses: maxim-lobanov/setup-xcode@v1
        with:
          xcode-version: latest-stable

      # Cache resolved SPM checkouts, keyed on Package.resolved (committed for app
      # projects — see .gitignore). Restore/save are split so the cache is written
      # even when the tests fail.
      - name: Restore SPM cache
        uses: actions/cache/restore@v5
        with:
          path: SourcePackages
          key: spm-${{ runner.os }}-${{ hashFiles('iOSAppTemplate.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved') }}
          restore-keys: |
            spm-${{ runner.os }}-

      # xcbeautify is preinstalled on the macos-15 runner image — no `brew install`
      # needed. Verify against the runner-images manifest if you change images.
      - name: Test
        run: |
          set -o pipefail
          xcodebuild test \
            -project "$PROJECT" \
            -scheme "$SCHEME" \
            -destination "platform=iOS Simulator,name=iPhone 16" \
            -clonedSourcePackagesDirPath SourcePackages \
            -resultBundlePath TestResults.xcresult \
            CODE_SIGNING_ALLOWED=NO 2>&1 | tee xcodebuild.log | xcbeautify --renderer github-actions

      - name: Upload xcresult
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: TestResults
          path: TestResults.xcresult
          retention-days: 7

      - name: Upload xcodebuild log
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: xcodebuild-log
          path: xcodebuild.log
          retention-days: 7

      - name: Save SPM cache
        if: always()
        uses: actions/cache/save@v5
        with:
          path: SourcePackages
          key: spm-${{ runner.os }}-${{ hashFiles('iOSAppTemplate.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved') }}

# ── Production tuning (uncomment / adapt as the project grows) ────────────────
# • Parallel tests — once the suite is large, shard across simulator clones:
#       -parallel-testing-enabled YES -parallel-testing-worker-count 4
#   (Swift Testing already parallelizes in-process; this adds cross-process
#   sharding.) Raise `timeout-minutes` to match the longer wall-clock budget.
# • Simulator / OS matrix — guard against version-specific breakage:
#       strategy:
#         matrix:
#           destination: ['name=iPhone 16', 'name=iPhone SE (3rd generation)']
# • Code coverage — add `-enableCodeCoverage YES`, then parse/upload the report.
# • Release smoke build — a build-only job on the Prod scheme catches config-
#   gated breakage the Dev tests miss.
# • Branch protection — mark `lint` and `test` as required status checks.
